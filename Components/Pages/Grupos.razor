    private async Task LeerCsvAsync(InputFileChangeEventArgs e)
    {
        _errorEstudiante = null;
        _csvResultado = null;
        try
        {
            var archivo = e.File;
            if (archivo.Size > 4 * 1024 * 1024)
            {
                _errorEstudiante = "El CSV supera el límite de 4 MB.";
                return;
            }

            await using var stream = archivo.OpenReadStream(4 * 1024 * 1024);
            using var reader = new StreamReader(stream, detectEncodingFromByteOrderMarks: true);
            _csvTexto = await reader.ReadToEndAsync();
            await PrevisualizarCsvAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error leyendo CSV de estudiantes");
            _errorEstudiante = $"No se pudo leer el CSV: {ex.Message}";
        }
    }

    private async Task PrevisualizarCsvAsync()
    {
        _csvResultado = null;
        _errorEstudiante = null;
        try
        {
            _csvPrevisualizacion = (await Importador.PrevisualizarAsync(_grupoCsvId, _csvTexto)).ToList();
            if (_csvPrevisualizacion.Count == 0)
            {
                _errorEstudiante = "No se detectaron filas en el contenido CSV.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error previsualizando CSV");
            _errorEstudiante = $"No se pudo interpretar el CSV: {ex.Message}";
        }
    }

    private async Task ImportarCsvAsync()
    {
        _errorEstudiante = null;
        if (string.IsNullOrWhiteSpace(_csvTexto))
        {
            _errorEstudiante = "Cargue un archivo o pegue el contenido CSV.";
            return;
        }

        _importandoCsvGuardando = true;
        try
        {
            _csvResultado = await Importador.ImportarAsync(_grupoCsvId, _csvTexto);
            _csvPrevisualizacion = Importador.Previsualizar(_csvTexto).ToList();
            await CargarEstudiantesAsync(_grupoCsvId);
            await ActualizarContadoresAsync();
            if (_csvResultado.Importados > 0)
            {
                _mensaje = $"Se importaron {_csvResultado.Importados} estudiante(s).";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importando CSV al grupo {GrupoId}", _grupoCsvId);
            _errorEstudiante = $"No se pudo importar el CSV: {ex.Message}";
        }
        finally
        {
            _importandoCsvGuardando = false;
        }
    }

