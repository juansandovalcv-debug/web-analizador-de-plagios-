    private async Task AgregarEstudianteAsync()
    {
        _errorEstudiante = null;
        var carnet = (_nuevoCarnet ?? string.Empty).Trim();
        var nombre = (_nuevoNombre ?? string.Empty).Trim();
        var correo = string.IsNullOrWhiteSpace(_nuevoCorreo) ? null : _nuevoCorreo.Trim();

        if (carnet.Length is < 2 or > 40)
        {
            _errorEstudiante = "El carnet debe tener entre 2 y 40 caracteres.";
            return;
        }

        if (nombre.Length is < 2 or > 160)
        {
            _errorEstudiante = "El nombre debe tener entre 2 y 160 caracteres.";
            return;
        }

        _guardandoEstudiante = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var duplicado = await db.Estudiantes.AnyAsync(e => e.GrupoId == _grupoEstudianteId && e.Carnet == carnet);
            if (duplicado)
            {
                _errorEstudiante = $"El carnet {carnet} ya está registrado en este grupo.";
                return;
            }

            db.Estudiantes.Add(new Estudiante
            {
                GrupoId = _grupoEstudianteId,
                Carnet = carnet,
                Nombre = nombre,
                Correo = correo,
                CreadoEn = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
            _nuevoCarnet = string.Empty;
            _nuevoNombre = string.Empty;
            _nuevoCorreo = null;
            _mensaje = $"Estudiante {nombre} agregado.";
            await CargarEstudiantesAsync(_grupoEstudianteId);
            await ActualizarContadoresAsync();
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Error agregando estudiante al grupo {GrupoId}", _grupoEstudianteId);
            _errorEstudiante = "No se pudo agregar el estudiante. Verifique el carnet.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error inesperado agregando estudiante");
            _errorEstudiante = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            _guardandoEstudiante = false;
        }
    }

