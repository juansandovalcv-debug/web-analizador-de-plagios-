    private async Task ImportarRespaldoAsync(InputFileChangeEventArgs e)
    {
        _importandoRespaldo = true;
        _avanceRespaldo = null;
        _error = null;
        try
        {
            var archivo = e.File;
            if (!Path.GetExtension(archivo.Name).Equals(".zip", StringComparison.OrdinalIgnoreCase))
            {
                _error = "Seleccione un archivo ZIP generado por la aplicación.";
                return;
            }

            if (archivo.Size > 64L * 1024 * 1024)
            {
                _error = "El respaldo supera el límite de 64 MB.";
                return;
            }

            await using var stream = archivo.OpenReadStream(64L * 1024 * 1024);
            _avanceRespaldo = await Respaldos.ImportarAsync(stream);
            _mensaje = $"Respaldo del grupo «{_avanceRespaldo.GrupoNombre}» importado.";
            await CargarGruposAsync(_avanceRespaldo.GrupoId);
        }
        catch (InvalidDataException ex)
        {
            _error = $"El respaldo no es válido: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importando respaldo");
            _error = $"No se pudo importar el respaldo: {ex.Message}";
        }
        finally
        {
            _importandoRespaldo = false;
        }
    }

