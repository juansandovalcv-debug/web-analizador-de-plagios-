    private async Task GuardarGrupoAsync()
    {
        _formError = null;
        var nombre = (_formNombre ?? string.Empty).Trim();
        var codigo = (_formCodigo ?? string.Empty).Trim();
        var ciclo = (_formCiclo ?? string.Empty).Trim();

        if (nombre.Length is < 2 or > 120)
        {
            _formError = "El nombre debe tener entre 2 y 120 caracteres.";
            return;
        }

        if (codigo.Length is < 2 or > 40)
        {
            _formError = "El código debe tener entre 2 y 40 caracteres.";
            return;
        }

        if (ciclo.Length is < 1 or > 30)
        {
            _formError = "El ciclo es obligatorio y no puede superar 30 caracteres.";
            return;
        }

        if (_formAnio is < 2000 or > 2100)
        {
            _formError = "El año debe estar entre 2000 y 2100.";
            return;
        }

        if (_formComputo is < 1 or > 3)
        {
            _formError = "El cómputo debe ser 1, 2 o 3.";
            return;
        }

        _guardando = true;
        _error = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var duplicado = await db.Grupos.AnyAsync(g =>
                g.Codigo == codigo && g.Anio == _formAnio && g.Ciclo == ciclo && g.Computo == _formComputo &&
                (_editandoId == null || g.Id != _editandoId.Value));

            if (duplicado)
            {
                _formError = "Ya existe un grupo con ese código en el mismo año, ciclo y cómputo.";
                return;
            }

            if (_editandoId is int id)
            {
                var grupo = await db.Grupos.FirstOrDefaultAsync(g => g.Id == id);
                if (grupo is null)
                {
                    _formError = "El grupo ya no existe.";
                    await CargarGruposAsync();
                    return;
                }

                grupo.Nombre = nombre;
                grupo.Codigo = codigo;
                grupo.Anio = _formAnio;
                grupo.Ciclo = ciclo;
                grupo.Computo = _formComputo;
                grupo.Descripcion = string.IsNullOrWhiteSpace(_formDescripcion) ? null : _formDescripcion.Trim();
                await db.SaveChangesAsync();
                _mensaje = $"Grupo «{nombre}» actualizado.";
                _mostrarFormulario = false;
                await CargarGruposAsync(id);
            }
            else
            {
                var grupo = new Grupo
                {
                    Nombre = nombre,
                    Codigo = codigo,
                    Anio = _formAnio,
                    Ciclo = ciclo,
                    Computo = _formComputo,
                    Descripcion = string.IsNullOrWhiteSpace(_formDescripcion) ? null : _formDescripcion.Trim(),
                    CreadoEn = DateTime.UtcNow
                };

                db.Grupos.Add(grupo);
                await db.SaveChangesAsync();
                _mensaje = $"Grupo «{nombre}» creado. Agregue estudiantes para comenzar a analizar.";
                _mostrarFormulario = false;
                await CargarGruposAsync(grupo.Id);
            }
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Error guardando grupo");
            _formError = "No se pudo guardar el grupo. Verifique que el código no esté repetido.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error inesperado guardando grupo");
            _formError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task EliminarGrupoAsync(GrupoResumen grupo)
    {
        var confirmado = await ConfirmarAsync(
            $"¿Eliminar el grupo «{grupo.Nombre}»?\n\nSe borrarán {grupo.TotalEstudiantes} estudiante(s), {grupo.TotalEvaluaciones} entrega(s) y su historial. Esta acción no se puede deshacer.");
        if (!confirmado)
        {
            return;
        }

        _error = null;
        _mensaje = null;
        try
        {
            List<string> archivos;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                archivos = await db.Evaluaciones
                    .Where(e => e.GrupoId == grupo.Id)
                    .Select(e => e.NombreAlmacenado)
                    .ToListAsync();

                var entidad = await db.Grupos.FirstOrDefaultAsync(g => g.Id == grupo.Id);
                if (entidad is null)
                {
                    return;
                }

                db.Grupos.Remove(entidad);
                await db.SaveChangesAsync();
            }

            foreach (var archivo in archivos)
            {
                await Almacen.EliminarAsync(archivo);
            }

            if (_expandidoId == grupo.Id)
            {
                _expandidoId = null;
            }

            _estudiantes.Remove(grupo.Id);
            _mensaje = $"Grupo «{grupo.Nombre}» eliminado.";
            await CargarGruposAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error eliminando grupo {GrupoId}", grupo.Id);
            _error = $"No se pudo eliminar el grupo: {ex.Message}";
        }
    }

