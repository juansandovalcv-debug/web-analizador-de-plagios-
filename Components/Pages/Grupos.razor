    private async Task CargarEstudiantesAsync(int grupoId)
    {
        _cargandoEstudiantes = true;
        _errorEstudiante = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _estudiantes[grupoId] = await db.Estudiantes
                .AsNoTracking()
                .Where(e => e.GrupoId == grupoId)
                .OrderBy(e => e.Nombre)
                .Select(e => new EstudianteVista
                {
                    Id = e.Id,
                    Nombre = e.Nombre,
                    Carnet = e.Carnet,
                    Correo = e.Correo,
                    Evaluaciones = e.Evaluaciones.Count(),
                    PromedioSimilitud = e.Evaluaciones.Select(x => (double?)x.Similitud).Average() ?? 0,
                    PromedioIA = e.Evaluaciones.Select(x => (double?)x.ProbabilidadIA).Average() ?? 0
                })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando estudiantes del grupo {GrupoId}", grupoId);
            _errorEstudiante = $"No se pudieron cargar los estudiantes: {ex.Message}";
        }
        finally
        {
            _cargandoEstudiantes = false;
        }
    }

